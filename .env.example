# Alamat API yang dipanggil browser. Biarkan "/api" supaya permintaan lewat proxy (Vite saat dev, Caddy saat
# production): /api/user/* diteruskan ke microservice user (login), /api/* & /storage/* ke backend Laravel (lpbe).
# Jangan isi alamat absolut seperti http://localhost:8000/api: proxy terlewati dan login ke /api/user/* jadi 404.
VITE_API_URL=/api

# Tujuan proxy Vite saat "npm run dev" (tidak ikut ter-build ke browser)
VITE_BACKEND_URL=http://127.0.0.1:8000
VITE_USER_API_URL=http://127.0.0.1:3002
